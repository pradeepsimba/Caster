<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer. -->
<data-extraction-rules>
    <cloud-backup>
        <!-- The key that proves this phone to a TV over ADB must never leave the phone. -->
        <exclude domain="file" path="adb_key" />
        <exclude domain="file" path="adb_key.pub" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="adb_key" />
        <exclude domain="file" path="adb_key.pub" />
    </device-transfer>
</data-extraction-rules>

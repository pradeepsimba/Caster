<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and older. -->
<full-backup-content>
    <!-- The keys that prove this phone to a TV (ADB key, Android TV certificate, Fire TV pairing token) must never leave the phone. -->
    <exclude domain="file" path="adb_key" />
    <exclude domain="file" path="adb_key.pub" />
    <exclude domain="file" path="atv_key" />
    <exclude domain="file" path="atv_cert" />
    <exclude domain="sharedpref" path="caster_tv.xml" />
    <!-- The choice of shared videos is a list of ids that mean other videos on another phone; the crash records are private. -->
    <exclude domain="sharedpref" path="caster_share.xml" />
    <exclude domain="sharedpref" path="caster_crash.xml" />
    <exclude domain="sharedpref" path="caster_cast.xml" />
    <exclude domain="sharedpref" path="caster_screens.xml" />
    <exclude domain="sharedpref" path="caster_lock.xml" />
    <exclude domain="sharedpref" path="caster_history.xml" />
    <exclude domain="sharedpref" path="caster_resume.xml" />
    <exclude domain="sharedpref" path="caster_wifi.xml" />
    <exclude domain="file" path="crash.log" />
    <exclude domain="file" path="activity.log" />
</full-backup-content>
